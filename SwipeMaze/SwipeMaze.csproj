<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android-only: a phone game, not a cross-platform product -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>SwipeMaze</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>Swipe Maze</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.ryanclaret.swipemaze</ApplicationId>
		<ApplicationIdGuid>b7d3e0a2-5c41-4f0e-9a6b-2d8c1f4e7a53</ApplicationIdGuid>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.2</ApplicationDisplayVersion>
		<ApplicationVersion>3</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>

		<!-- Release builds run on the JIT, not ahead-of-time compiled. A maze game doesn't need the
		     faster startup, and AOT would require the extra Android cross-compiler workload packs
		     (several hundred MB each) to be installed on every build machine. -->
		<RunAOTCompilation>false</RunAOTCompilation>
		<AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
	</ItemGroup>

	<ItemGroup>
		<!-- App icon: a spiral maze (green) with the yellow avatar in the middle, on cream -->
		<MauiIcon Include="Resources\appicon.svg" ForegroundFile="Resources\appiconfg.svg" Color="#FFF8E7" />

		<!-- Splash screen -->
		<MauiSplashScreen Include="Resources\appiconfg.svg" Color="#FFF8E7" BaseSize="128,128" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SwipeMaze.Core\SwipeMaze.Core.csproj" />
	</ItemGroup>

</Project>
